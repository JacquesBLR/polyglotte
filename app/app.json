{
  "expo": {
    "name": "Polyglotte",
    "slug": "polyglotte",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jacquesblr.polyglotte",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jacquesblr.polyglotte",
      "adaptiveIcon": {
        "backgroundColor": "#c2410c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/polyglotte"
    },
    "plugins": [
      "expo-sharing",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Polyglotte écoute le micro pour que tu puisses parler à ton tuteur dans la langue que tu apprends.",
          "speechRecognitionPermission": "Polyglotte transcrit ta parole pour comprendre ce que tu dis dans la langue que tu apprends."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Polyglotte enregistre ta voix pour la transcrire via ton serveur vocal, pour les langues dont l'oral n'est pas pris en charge par l'appareil."
        }
      ]
    ]
  }
}
