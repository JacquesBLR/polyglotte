# Unité systemd du serveur vocal Polyglotte (#45) — à installer sur le DGX :
#   sudo cp serveur-vocal/polyglotte-vocal.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now polyglotte-vocal
[Unit]
Description=Serveur vocal Polyglotte (STT faster-whisper + TTS Piper)
After=network-online.target

[Service]
User=omniapp
WorkingDirectory=/home/omniapp/Documents/projets/polyglotte/serveur-vocal
# 127.0.0.1 uniquement : l'accès distant passe par tailscale serve (TLS), qui
# écoute lui-même l'IP tailnet — un bind 0.0.0.0 court-circuiterait le proxy TLS.
ExecStart=/home/omniapp/Documents/projets/polyglotte/serveur-vocal/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8664
Restart=on-failure
RestartSec=5
Environment=VOCAL_STT_MODEL=small

[Install]
WantedBy=multi-user.target
